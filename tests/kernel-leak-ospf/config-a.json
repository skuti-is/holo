{
  "ietf-interfaces:interfaces": {
    "interface": [
      {
        "name": "veth-a",
        "type": "iana-if-type:ethernetCsmacd",
        "ietf-ip:ipv6": {}
      }
    ]
  },
  "ietf-routing-policy:routing-policy": {
    "defined-sets": {
      "prefix-sets": {
        "prefix-set": [
          {
            "name": "TS-V6",
            "mode": "ipv6",
            "prefixes": {
              "prefix-list": [
                {
                  "ip-prefix": "fd7a:115c:a1e0::/48",
                  "mask-length-lower": 128,
                  "mask-length-upper": 128
                }
              ]
            }
          }
        ]
      }
    },
    "policy-definitions": {
      "policy-definition": [
        {
          "name": "IMPORT-TAILSCALE",
          "statements": {
            "statement": [
              {
                "name": "10",
                "conditions": {
                  "match-prefix-set": {
                    "prefix-set": "TS-V6"
                  }
                },
                "actions": {
                  "policy-result": "accept-route"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "ietf-routing:routing": {
    "ribs": {
      "rib": [
        {
          "name": "tailscale-v6",
          "address-family": "ietf-routing:ipv6",
          "default-rib": false,
          "holo-routing:kernel-table-id": 52
        },
        {
          "name": "ipv6-unicast",
          "address-family": "ietf-routing:ipv6",
          "default-rib": true,
          "holo-routing:import-rib": [
            {
              "source-rib": "tailscale-v6",
              "import-policy": "IMPORT-TAILSCALE"
            }
          ]
        }
      ]
    },
    "control-plane-protocols": {
      "control-plane-protocol": [
        {
          "type": "ietf-ospf:ospfv3",
          "name": "main",
          "ietf-ospf:ospf": {
            "explicit-router-id": "10.0.0.1",
            "areas": {
              "area": [
                {
                  "area-id": "0.0.0.0",
                  "interfaces": {
                    "interface": [
                      {
                        "name": "veth-a",
                        "interface-type": "point-to-point",
                        "hello-interval": 1,
                        "dead-interval": 4
                      }
                    ]
                  }
                }
              ]
            },
            "holo-ospf:redistribute": [
              {
                "type": "holo-routing:kernel"
              }
            ],
            "holo-ospf:trace-options": {
              "flag": [
                {
                  "name": "internal-bus",
                  "enabled": true
                },
                {
                  "name": "lsdb",
                  "enabled": true
                },
                {
                  "name": "flooding",
                  "enabled": true
                }
              ]
            }
          }
        }
      ]
    }
  }
}